<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <AppSettings>
    <SettingsPath>C:\ProgramData\VELUM\Settings</SettingsPath>
    <DefaultStileId>6</DefaultStileId>
    <DefaultAdaptiveActionId>1</DefaultAdaptiveActionId>
    <RecognitionThreshold>3</RecognitionThreshold>
    <CompareLevel>30</CompareLevel>
    <DifSensorPar>0.02</DifSensorPar>
    <DynamicTime>2</DynamicTime>
    <DefaultGeneticReflexId>0</DefaultGeneticReflexId>
    <FirstRun>1</FirstRun>
    <LogEnabled>true</LogEnabled>
    <DefaultFormatLog>All</DefaultFormatLog>
    <LogsFolderPath>C:\ProgramData\VELUM\Logs</LogsFolderPath>
    <BootDataFolderPath>C:\ProgramData\VELUM\BootData</BootDataFolderPath>
    <ReflexActionDisplayDuration>1</ReflexActionDisplayDuration>
    <WaitingPeriodForActionsVal>30</WaitingPeriodForActionsVal>
    <DefaultThemeTypeId>4</DefaultThemeTypeId>
    <ThinkingCycleDecayAgeDivisor>100</ThinkingCycleDecayAgeDivisor>
    <ThinkingCycleDecayBase>1</ThinkingCycleDecayBase>
    <ThinkingCycleMainMaxAgePulses>1000</ThinkingCycleMainMaxAgePulses>
    <NoOperatorStimulusSilencePulses>30</NoOperatorStimulusSilencePulses>
    <ScenarioReportsFolderPath>C:\ProgramData\VELUM\Scenarios\Reports</ScenarioReportsFolderPath>
    <HomeostasisPulseSpeedDriftEnabled>false</HomeostasisPulseSpeedDriftEnabled>
    <DataFolderPath>C:\ProgramData\VELUM\Data</DataFolderPath>
    <ProjectsFolderPath>C:\ProgramData\VELUM\Projects</ProjectsFolderPath>
    <AdaptersFolderPath>C:\ProgramData\VELUM\Adapters</AdaptersFolderPath>
    <SolidEnvironmentMetricDeltaEpsilon>0.51</SolidEnvironmentMetricDeltaEpsilon>
    <SolidHostImpulseMinParameterDelta>0.25</SolidHostImpulseMinParameterDelta>
    <SolidHomeostasisPulseTrace>false</SolidHomeostasisPulseTrace>
    <SolidProbeTimeoutMs>2500</SolidProbeTimeoutMs>
    <SolidProbeUseStaleSnapshotOnTimeout>true</SolidProbeUseStaleSnapshotOnTimeout>
    <HeavyMetricsPulsePeriod>5</HeavyMetricsPulsePeriod>
    <CadDegradedEnterThreshold>50</CadDegradedEnterThreshold>
    <CadDegradedExitThreshold>60</CadDegradedExitThreshold>
    <RecipeDispatchEnabled>true</RecipeDispatchEnabled>
    <RecipeDispatchCooldownPulses>3</RecipeDispatchCooldownPulses>
    <DxfFileNameTemplate></DxfFileNameTemplate>
    <DxfFileNameTemplateLastUsed></DxfFileNameTemplateLastUsed>
    <DxfFileNameSuffixList></DxfFileNameSuffixList>
    <DxfBatchDefaultDxfFolder></DxfBatchDefaultDxfFolder>
    <PdfBatchDefaultPdfFolder></PdfBatchDefaultPdfFolder>
    <AssemblyRegistryDxfExportFolder></AssemblyRegistryDxfExportFolder>
    <AssemblyRegistryPdfExportFolder></AssemblyRegistryPdfExportFolder>
    <MaterialBatchDefaultPartsFolder></MaterialBatchDefaultPartsFolder>
    <DocumentPropertyBatchDefaultCatalogFolder></DocumentPropertyBatchDefaultCatalogFolder>
    <DocumentPropertyPartTemplatePath>Деталь.prtprp</DocumentPropertyPartTemplatePath>
    <DocumentPropertyAsmTemplatePath>Сборка.asmprp</DocumentPropertyAsmTemplatePath>
    <BatchProjectRootPartsFolderName>Детали</BatchProjectRootPartsFolderName>
    <DxfDefaultProjectionView>Front</DxfDefaultProjectionView>
    <DxfDefaultOutputFolder>C:\Users\user_\Desktop\Новая папка\Детали</DxfDefaultOutputFolder>
    <PdfDefaultOutputFolder></PdfDefaultOutputFolder>
    <CommandBufferIdleFlushMs>3000</CommandBufferIdleFlushMs>
    <CommandBufferRecordingEnabled>true</CommandBufferRecordingEnabled>
    <CommandBufferMaxTokens>64</CommandBufferMaxTokens>
    <CommandBufferMaxAgeMs>120000</CommandBufferMaxAgeMs>
    <EnvironmentRecipesFilePath>%ProgramData%\VELUM\BootData\Environment\EnvironmentRecipes.yaml</EnvironmentRecipesFilePath>
    <ProductRegistryAccessLevel>user</ProductRegistryAccessLevel>
    <ProductRegistryFolderPath>%ProgramData%\VELUM\ProductRegistry</ProductRegistryFolderPath>
    <TechRequirementsFolderPath>%ProgramData%\VELUM\TechRequirements</TechRequirementsFolderPath>
    <AssemblyRegistryFolderPath>%ProgramData%\VELUM\AssemblyRegistry</AssemblyRegistryFolderPath>
  </AppSettings>
</Configuration>