          "type": "enum",
          "defaultValue": "front",
          "values": [
            { "key": "front", "label": "Спереди (Front)" },
            { "key": "top", "label": "Сверху (Top)" },
            { "key": "right", "label": "Справа (Right)" }
          ]
        }
      ]
    },
    {
      "id": "sketch_line",
      "label": "Линия в эскизе (универсальный токен)",
      "description": "Рисует отрезок (SketchManager.CreateLine). Если в активном документе уже открыт эскиз — линия дописывается в текущий эскиз без создания нового; иначе выбирается базовая плоскость и открывается новый эскиз. Координаты в мм, допускают шаблоны {NAME} и переменные психики {V:имя}. Задают либо x1/y1(/z1) и x2/y2(/z2), либо length (+ необязательный angle от оси X, град). Только SLDPRT.",
      "argsSchema": [
        {
          "key": "plane",
          "label": "Базовая плоскость (если эскиза нет)",
          "type": "enum",
          "defaultValue": "front",
