    {
      "id": "export_documentation_dialog",
      "label": "Диалог экспорта DXF",
      "description": "Модальная форма экспорта детали в DXF: каталог, шаблон имени, проекция",
      "argsSchema": []
    },
    {
      "id": "export_drawing_pdf_dialog",
      "label": "Диалог экспорта PDF",
      "description": "Модальная форма экспорта чертежа в PDF: выбор каталога, имя файла = имя чертежа",
      "argsSchema": []
    },
    {
      "id": "finalize_dxf_metadata_dialog",
      "label": "Диалог фиксации DXF",
      "description": "Модальная форма фиксации метаданных после ручной выгрузки DXF: каталог, имя, вид, штамп, отпечаток файла",
      "argsSchema": []
    },
    {
      "id": "ensure_blank_size_property_links",
      "label": "Ссылки Толщина/Длина/Ширина (листовая)",
      "description": "Только SLDPRT с Sheet Metal + FlatPattern: выставляет или чинит живые ссылки свойств заготовки (не числа)",
      "argsSchema": [
        {
          "key": "config",
          "label": "Конфигурация",
          "type": "enum",
          "values": [
            { "key": "document", "label": "Свойство документа" },
            { "key": "active", "label": "Активная конфигурация" },
            { "key": "default", "label": "Конфигурация по умолчанию" }
          ]
        },
        {
          "key": "overwrite",
          "label": "Политика перезаписи",
          "type": "enum",
          "defaultValue": "repair",
          "values": [
            { "key": "repair", "label": "Пусто или битая ссылка" },
            { "key": "if_empty", "label": "Только если пусто" },
            { "key": "always", "label": "Всегда" },
            { "key": "never", "label": "Не записывать" }
          ]
        }
      ]
    },
    {
      "id": "export_documentation_create_files",
      "label": "Создать PDF/DXF",
      "description": "Программное создание сопроводительных файлов для деталей с логическим Yes (вызывается из диалога)",
      "argsSchema": []
    },
    {
      "id": "run_sw_command",
      "label": "Команда SolidWorks",
      "description": "Вызов RunCommand по command_id",
      "argsSchema": [
        { "key": "command_id", "label": "Command ID", "type": "int", "required": true }
      ]
    },
    {
      "id": "run_macro",
      "label": "Выполнить макрос",
      "description": "Запуск макроса SolidWorks через RunMacro2 (VBA .swp или VSTA .dll). Укажите файл, модуль и процедуру (для VBA обычно Module1 / main).",
      "argsSchema": [
        {
          "key": "path",
          "label": "Файл макроса",
          "type": "string",
          "required": true,
          "editorHint": "macro_file"
        },
        {
          "key": "module",
          "label": "Модуль",
          "type": "string",
          "defaultValue": "Module1"
        },
        {
          "key": "procedure",
          "label": "Процедура",
          "type": "string",
          "defaultValue": "main"
        }
      ]
    },
    {
      "id": "rebuild",
      "label": "Перестроить модель",
      "description": "EditRebuild3 активного документа",
      "argsSchema": []
    },
    {
      "id": "log",
      "label": "Запись в лог",
      "description": "Сообщение в лог Velum (шаблоны {PLACEHOLDER} поддерживаются в message)",
      "argsSchema": [
        { "key": "message", "label": "Сообщение", "type": "string" },
        {
          "key": "level",
          "label": "Уровень",
          "type": "enum",
          "values": [
            { "key": "info", "label": "Информация" },
            { "key": "warning", "label": "Предупреждение" },
            { "key": "error", "label": "Ошибка" }
          ]
        }
      ]
    },
    {
      "id": "product_registry_show_problems",
      "label": "Показать проблемы реестра",
      "description": "Модальный список проблем целостности реестра изделий (битые ссылки / нет чертежей)",
      "argsSchema": []
    },
    {
      "id": "bom_exchange_show_dialog",
      "label": "Обмен BOM с 1С",
      "description": "Модальный диалог формирования CSV-файла обмена с 1С: расхождения состава и отслеживаемых свойств компонентов",
      "argsSchema": []
    },
    {
      "id": "bom_exchange_export",
      "label": "Экспорт BOM в 1С (CSV)",
      "description": "Программный экспорт расхождений BOM в CSV в каталог обмена; после успеха расхождения сбрасываются",
      "argsSchema": [
        {
          "key": "exchangeFolder",
          "label": "Каталог обмена",
          "type": "string",
          "editorHint": "folder_path"
        }
      ]
