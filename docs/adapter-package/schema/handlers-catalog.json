          "key": "cy",
          "label": "Центр Y, мм",
          "type": "string",
          "defaultValue": "0",
          "editorHint": "template_placeholder"
        },
        {
          "key": "plane",
          "label": "Базовая плоскость (если эскиза нет)",
          "type": "enum",
          "defaultValue": "front",
          "values": [
            { "key": "front", "label": "Спереди (Front)" },
            { "key": "top", "label": "Сверху (Top)" },
            { "key": "right", "label": "Справа (Right)" }
          ]
        }
      ]
    },
    {
      "id": "sketch_polygon_inscribed",
      "label": "Многоугольник по вписанной окружности",
      "description": "Рисует правильный многоугольник с центром (cx,cy), числом сторон sides и вписанной окружностью диаметра diameter (стороны касаются окружности Ø=diameter; «под ключ»). В отличие от sketch_polygon (где diameter — диаметр через вершины), опорная точка отодвигается на радиус описанной окружности (diameter/2)/cos(π/sides), чтобы расстояние центр–середина стороны (апофема) стало diameter/2. Если в активном документе уже открыт эскиз — фигура дорисовывается в текущий эскиз; иначе открывается новый на базовой плоскости. Перед закрытием созданного эскиза он полностью определяется (проставляются размеры). Диаметр и центр в мм, sides — целое ≥ 3; допускают шаблоны {NAME} и переменные психики {V:имя}. Только SLDPRT.",
      "argsSchema": [
        {
          "key": "sides",
          "label": "Число сторон",
          "type": "string",
          "required": true,
          "editorHint": "template_placeholder"
        },
        {
          "key": "diameter",
          "label": "Диаметр вписанной окружности (по сторонам), мм",
          "type": "string",
          "required": true,
          "editorHint": "template_placeholder"
        },
        {
          "key": "cx",
