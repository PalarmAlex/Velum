    {
      "id": "sketch_polygon",
      "label": "Правильный многоугольник",
      "description": "Рисует правильный многоугольник с центром (cx,cy), числом сторон sides и описанной окружностью диаметра diameter (через вершины). Если в активном документе уже открыт эскиз — фигура дорисовывается в текущий эскиз; иначе открывается новый на базовой плоскости. Перед закрытием созданного эскиза он полностью определяется (проставляются размеры). Диаметр и центр в мм, sides — целое ≥ 3; допускают шаблоны {NAME} и переменные психики {V:имя}. Только SLDPRT.",
      "argsSchema": [
        {
          "key": "sides",
          "label": "Число сторон",
          "type": "string",
          "required": true,
          "editorHint": "template_placeholder"
        },
        {
          "key": "diameter",
          "label": "Диаметр описанной окружности (через вершины), мм",
          "type": "string",
          "required": true,
          "editorHint": "template_placeholder"
