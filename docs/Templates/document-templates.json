{
  "schemaVersion": "document-templates/1",
  "templates": [
    {
      "templateId": "plate.standard",
      "displayName": "Пластина прямоугольная",
      "documentType": "part",
      "templateFile": "Parts/plate.sldprt",
      "templateSchema": "1",
      "defaultConfiguration": null,
      "fingerprint": {
        "requiredEquations": [ "L", "W", "T" ],
        "requiredProperties": [ "Velum.TemplateId" ],
        "requiredFeatures": [],
        "configCountMin": 1
      },
      "parameters": [
        {
          "id": "L",
          "label": "Длина",
          "type": "number",
          "unit": "mm",
          "min": 10,
          "max": 1000,
          "default": 120,
          "step": 5,
          "address": "equation:L",
          "writePolicy": "always",
          "onInvalid": "clamp",
          "scope": "document"
        },
        {
          "id": "W",
          "label": "Ширина",
          "type": "number",
          "unit": "mm",
          "min": 10,
          "max": 1000,
          "default": 80,
          "step": 5,
          "address": "equation:W",
          "writePolicy": "always",
          "onInvalid": "clamp",
          "scope": "document"
        },
        {
          "id": "T",
          "label": "Толщина",
          "type": "number",
          "unit": "mm",
          "min": 0.5,
          "max": 100,
          "default": 3,
          "step": 0.5,
          "address": "equation:T",
          "writePolicy": "always",
          "onInvalid": "clamp",
          "scope": "document"
        }
      ],
      "metrics": [
        {
          "probeKey": "Velum.Solid.Parameters.Geometry",
          "parameters": [ "L", "W", "T" ],
          "mode": "all"
        }
      ]
    }
  ]
}
