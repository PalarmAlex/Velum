  <Target Name="EnsureIsidaBuilt" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\..\ISIDA\Programms\isida\bin\$(Configuration)\isida.dll')" Text="Отсутствует сборка isida: ..\..\ISIDA\Programms\isida\bin\$(Configuration)\isida.dll. Соберите проект isida (конфигурация $(Configuration))." />
  </Target>
  <Target Name="EnsureSymbiontEnvContractBuilt" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\..\ISIDA\Programms\app\SymbiontEnv.Contract\bin\$(Configuration)\SymbiontEnv.Contract.dll')" Text="Отсутствует SymbiontEnv.Contract.dll: ..\..\ISIDA\Programms\app\SymbiontEnv.Contract\bin\$(Configuration)\. Соберите SymbiontEnv.Contract.csproj (конфигурация $(Configuration))." />
  </Target>
  <Target Name="CopyIsidaRuntimeAssemblies" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_IsidaBinaries Include="..\..\ISIDA\Programms\isida\bin\$(Configuration)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_IsidaBinaries)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('..\..\ISIDA\Programms\isida\bin\$(Configuration)\isida.dll')" />
  </Target>
  <Target Name="CopyAdapterPackage" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_AdapterPackageFiles Include="adapter-package\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AdapterPackageFiles)" DestinationFiles="@(_AdapterPackageFiles->'$(OutputPath)adapter-package\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('adapter-package\manifest.json')" />
    <Delete Files="$(OutputPath)adapter-package\schema\expression-pattern-catalog.json" Condition="Exists('$(OutputPath)adapter-package\schema\expression-pattern-catalog.json')" />
    <Delete Files="$(OutputPath)adapter-package\schema\trigger-detect.json" Condition="Exists('$(OutputPath)adapter-package\schema\trigger-detect.json')" />
    <Delete Files="$(OutputPath)adapter-package\schema\trigger-catalog.json" Condition="Exists('$(OutputPath)adapter-package\schema\trigger-catalog.json')" />
    <Delete Files="$(OutputPath)adapter-package\BootData\Environment\EnvironmentTriggers.yaml" Condition="Exists('$(OutputPath)adapter-package\BootData\Environment\EnvironmentTriggers.yaml')" />
  </Target>
  <Target Name="CopyVelumHelp" AfterTargets="CopyFilesToOutputDirectory">
    <PropertyGroup>
      <_VelumHelpProgramData>$(ALLUSERSPROFILE)\VELUM\help</_VelumHelpProgramData>
    </PropertyGroup>
    <ItemGroup>
      <_VelumHelpFiles Include="docs\help\**\*" />
    </ItemGroup>
    <!-- Рядом с dll (отладка) и в %ProgramData%\VELUM\help (как у установщика). -->
    <Copy SourceFiles="@(_VelumHelpFiles)" DestinationFiles="@(_VelumHelpFiles->'$(OutputPath)help\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('docs\help\index.html')" />
    <MakeDir Directories="$(_VelumHelpProgramData)" Condition="Exists('docs\help\index.html')" />
    <Copy SourceFiles="@(_VelumHelpFiles)" DestinationFiles="@(_VelumHelpFiles->'$(_VelumHelpProgramData)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('docs\help\index.html')" />
  </Target>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>Отсутствует пакет NuGet. Выполните восстановление: nuget restore или откройте решение в Visual Studio. Отсутствует: {0}</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('packages\Xarial.XCad.SolidWorks.0.8.1\build\Xarial.XCad.SolidWorks.targets')" Text="$([System.String]::Format('$(ErrorText)', 'packages\Xarial.XCad.SolidWorks.0.8.1\build\Xarial.XCad.SolidWorks.targets'))" />
  </Target>
