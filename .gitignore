# ============================================
# Velum — .gitignore
# Исключает служебные и сгенерированные файлы
# ============================================

# --------------------------------------------
# 1. Сборка и временные файлы MSBuild
# --------------------------------------------
bin/
obj/
*.ipch
*.ilk
*.pdb
*.exp
*.bsc

# --------------------------------------------
# 2. NuGet пакеты (восстанавливаются из packages.config)
# --------------------------------------------
packages/
*.nupkg

# --------------------------------------------
# 3. Файлы Visual Studio
# --------------------------------------------
*.suo
*.user
.vs/
project.lock.json
project.fragment.json
*.cache

# --------------------------------------------
# 4. Инсталляторы и setup-проекты
# --------------------------------------------
installer/
Setup/

# --------------------------------------------
# 5. IDE / AI-ассистенты (не нужны в репозитории)
# --------------------------------------------
.cursor/
.idea/
*.psess
*.CodeSSI

# --------------------------------------------
# 6. Логи и диагностические файлы
# --------------------------------------------
*.log
msbuild-debug-out.txt

# --------------------------------------------
# 7. Временные файлы Windows / macOS / Linux
# --------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~

# --------------------------------------------
# 8. Внешние зависимости (не часть репозитория)
# --------------------------------------------
# Ссылки на внешние сборки isida и SymbiontEnv
# These are referenced from other repositories and must not be committed

# --------------------------------------------
# Дополнительные исключения
# --------------------------------------------
nuget.exe

# Сгенерированные отчёты
docs/AssemblyRegistry/Reports/

# Backup и временные файлы данных
docs/Data/**/*.bak
docs/Data/**/*.tmp

# Вспомогательные скрипты (не нужны в репозитории)
Common/AssemblyRegistry/fix_designer.py
Common/ProductRegistry/test.txt
